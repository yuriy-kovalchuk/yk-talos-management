#!/bin/sh
set -e

echo "Running tests before push..."
go test -race -timeout 120s ./...

echo "Checking generated manifests are up-to-date..."
make manifests
git diff --exit-code config/crd/bases/ config/rbac/role.yaml charts/yk-talos-management/templates/crds/ || {
  echo "CRD/RBAC manifests are out of date. Commit the result of 'make manifests'."
  exit 1
}

echo "Checking commit message format..."
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    commits=$(git log --format="%H" "$local_sha" --not --remotes 2>/dev/null)
  else
    commits=$(git log --format="%H" "$remote_sha..$local_sha")
  fi

  for commit in $commits; do
    msg=$(git log -1 --format="%s" "$commit")
    if ! echo "$msg" | grep -qE '^(feat|fix|refactor|test|docs|build|ci|chore|perf|style)(\([^)]+\))?!?: .+'; then
      echo "Bad commit message: $commit"
      echo "  $msg"
      echo "  Expected: type: description  (see docs/commits.md)"
      exit 1
    fi
  done
done
